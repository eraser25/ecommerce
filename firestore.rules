rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /marketplaces/{marketplaceId} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /system/{document=**} {
      allow read, write: if true;
    }
  }
}
